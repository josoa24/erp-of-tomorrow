# Variables d'environnement du projet (exemple, sans valeur reelle).
#
# Spring Boot ne lit PAS ce fichier automatiquement : il sert de reference.
# Definir les variables dans le terminal (PowerShell : $env:NOM = "valeur"),
# dans la configuration de lancement de l'IDE, ou dans le service de deploiement.
# Ne jamais commiter un vrai fichier .env (il est ignore par .gitignore).
#
# DB_URL, DB_USER et DB_PASSWORD ont le meme nom dans chaque service :
# les definir service par service, dans le terminal de chacun.

# --- Secret JWT : identique dans la gateway ET dans auth-service (32 caracteres minimum) ---
JWT_SECRET=changez-moi-secret-long-et-aleatoire

# --- auth-service (port 8084) ---
JWT_TTL_MINUTES=480
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi

# --- Base de donnees d'un service (valeurs par defaut en developpement local) ---
# auth-service : jdbc:postgresql://localhost:5434/auth_db
# stock-service : jdbc:postgresql://localhost:5433/stock_db
# vente-service : jdbc:postgresql://localhost:5432/vente_db
# rh-service : jdbc:postgresql://localhost:5431/rh_db
DB_URL=jdbc:postgresql://localhost:5433/stock_db
DB_USER=postgres
DB_PASSWORD=changez-moi

# --- vente-service (port 8082) : adresse du service Stock ---
STOCK_URL=http://localhost:8083

# --- gateway (port 8080) : adresse des services ---
AUTH_URL=http://localhost:8084
RH_URL=http://localhost:8081
VENTE_URL=http://localhost:8082
# STOCK_URL est aussi lu par la gateway (meme nom que pour vente-service)

# --- apps React Native : adresse de la gateway ---
EXPO_PUBLIC_API_URL=http://localhost:8080/api/stock
