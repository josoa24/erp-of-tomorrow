# Adresse de la gateway appelee par le navigateur.
# Laisser vide en developpement : le serveur Vite redirige /api vers la gateway (voir API_PROXY_TARGET).
VITE_API_URL=

# Cible du proxy /api du serveur de developpement (lue par vite.config.ts).
# Local : http://localhost:8080 ; dans docker compose : http://gateway:8080
API_PROXY_TARGET=http://localhost:8080
