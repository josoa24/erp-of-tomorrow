# Variables à saisir dans Dokploy (onglet Environment du service Compose). Ne jamais commiter de vraies valeurs.
# Générer les secrets : openssl rand -base64 36

# Secret de signature des jetons, partagé par la gateway et l'auth-service (32 caractères minimum).
JWT_SECRET=
JWT_TTL_MINUTES=480

# Compte administrateur créé au premier démarrage.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# PostgreSQL : le super-utilisateur et un mot de passe par service (schémas isolés).
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
STOCK_DB_PASSWORD=
VENTE_DB_PASSWORD=
RH_DB_PASSWORD=
CRM_DB_PASSWORD=
MODULE_DB_PASSWORD=

# Assistant IA (facultatif : sans clé, l'assistant répond seulement par reconnaissance de mots-clés).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Origines autorisées par la gateway (inutile en pratique : le front et l'API partagent la même origine).
CORS_ALLOWED_ORIGINS=https://erp.exemple.mg

# Mémoire par service Java, et voix (profil facultatif « voice »).
JAVA_SERVICE_MEMORY=512m
VOICE_MODEL_SIZE=small
