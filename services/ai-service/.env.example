# ai-service — exemple sans valeur réelle. Copier en .env (jamais commité).

# --- Gemini (obligatoire) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Réflexion : Gemini 3.x -> GEMINI_THINKING_LEVEL=minimal|low ; Gemini 2.5 -> GEMINI_THINKING_BUDGET=0
# GEMINI_THINKING_LEVEL=low

# --- Gateway de l'ERP (tous les appels métier passent par elle avec le token de l'utilisateur) ---
# Lancement local (uvicorn) : http://localhost:8080
# Lancement Docker (gateway sur la machine hôte) : http://host.docker.internal:8080
ERP_GATEWAY_URL=http://localhost:8080
ERP_TIMEOUT_S=10

# --- Orchestration ---
MAX_TOOL_TURNS=5
TOOL_TIMEOUT_S=15
GEMINI_TIMEOUT_S=30
GEMINI_RETRY_ATTEMPTS=2
CHECK_MODEL_ON_STARTUP=true
LOG_LEVEL=INFO

# --- Conversations et écritures (mémoire vive, perdue au redémarrage) ---
CONFIRMATION_TTL_MIN=10
CONVERSATION_TTL_MIN=30
MAX_HISTORY_TURNS=6
HISTORY_MAX_CHARS=1500
MAX_CONVERSATIONS=1000

# --- Journal des actions IA (SQLite ; chemin relatif au dossier ai-service, dossier data/ ignoré par git) ---
AI_AUDIT_DB=data/ai_audit.db

# --- Limite de débit : requêtes vers l'assistant par utilisateur et par minute (au-delà : 429) ---
AI_RATE_LIMIT_PER_MINUTE=20

# --- Factures fournisseurs (/invoices/extract) : taille maximale du document, en Mo ---
INVOICE_MAX_MB=8
